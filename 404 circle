<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>404 | The Loom Room by Neri</title>
  <meta name="description" content="This page could not be found. Return to The Loom Room by Neri, browse Insights, or explore Expertise.">
  <meta name="robots" content="noindex,follow">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">
  <link rel="icon" type="image/png" href="favicon.png">
  <link rel="apple-touch-icon" href="favicon.png">
  <meta name="theme-color" content="#3155FF">

  <style>
    .site-header .brand{
      display:inline-flex;
      align-items:center;
      gap:10px;
      text-decoration:none;
      white-space:nowrap;
    }

    .site-header .brand-name{
      font:inherit;
      color:inherit;
    }

    .site-header .brand-author{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:6px 10px;
      border-radius:6px;
      background:var(--blue, #3155FF);
      color:#fff;
      font-family:"DM Sans",sans-serif;
      font-size:.68rem;
      font-weight:700;
      line-height:1;
      letter-spacing:.02em;
      white-space:nowrap;
    }

    .error-page{
      position:relative;
      overflow:hidden;
      min-height:72vh;
      display:grid;
      align-items:center;
      padding:90px 6vw 110px;
      background:var(--cream, #FFF9F2);
      isolation:isolate;
    }

    .error-page::before{
      content:"";
      position:absolute;
      width:340px;
      height:340px;
      border:42px solid var(--pink, #F43F8C);
      border-radius:50%;
      top:40px;
      right:-110px;
      z-index:-1;
      opacity:.96;
    }

    .error-page::after{
      content:"";
      position:absolute;
      width:280px;
      height:30px;
      background:var(--coral, #FF6B5E);
      transform:rotate(-28deg);
      left:-80px;
      bottom:80px;
      z-index:-1;
    }

    .error-inner{
      max-width:1040px;
      margin:0 auto;
      width:100%;
      position:relative;
    }

    .error-kicker{
      margin:0 0 18px;
      font-family:"DM Sans",sans-serif;
      font-size:.8rem;
      font-weight:700;
      letter-spacing:.16em;
      text-transform:uppercase;
      color:var(--blue, #3155FF);
    }

    .error-code{
      margin:0 0 12px;
      font-family:"DM Sans",sans-serif;
      font-size:clamp(1rem, 1.4vw, 1.2rem);
      font-weight:700;
      color:var(--slate, #6E7C87);
    }

    .error-title{
      margin:0;
      max-width:880px;
      font-family:"Playfair Display",serif;
      font-size:clamp(4rem, 10vw, 9rem);
      line-height:.9;
      letter-spacing:-.05em;
      color:var(--ink, #17171C);
    }

    .error-title .blue{
      color:var(--blue, #3155FF);
    }

    .error-copy{
      max-width:690px;
      margin:28px 0 0;
      font-family:"DM Sans",sans-serif;
      font-size:clamp(1rem, 1.8vw, 1.25rem);
      line-height:1.65;
      color:var(--slate, #6E7C87);
    }

    .error-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:34px;
    }

    .error-actions a{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:48px;
      padding:12px 18px;
      border-radius:8px;
      font-family:"DM Sans",sans-serif;
      font-weight:700;
      text-decoration:none;
      transition:transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
    }

    .error-actions a:hover{
      transform:translateY(-2px);
    }

    .error-actions .primary{
      background:var(--blue, #3155FF);
      border:1px solid var(--blue, #3155FF);
      color:#fff;
    }

    .error-actions .secondary{
      background:transparent;
      border:1px solid var(--ink, #17171C);
      color:var(--ink, #17171C);
    }

    .error-actions .secondary:hover{
      border-color:var(--blue, #3155FF);
      color:var(--blue, #3155FF);
    }

    .thread-mark{
      position:absolute;
      right:16%;
      bottom:5%;
      width:120px;
      height:120px;
      pointer-events:none;
    }

    .thread-mark::before,
    .thread-mark::after{
      content:"";
      position:absolute;
      border-radius:999px;
    }

    .thread-mark::before{
      width:92px;
      height:18px;
      background:var(--mint, #79E6C4);
      transform:rotate(38deg);
      left:0;
      top:42px;
    }

    .thread-mark::after{
      width:24px;
      height:24px;
      background:var(--yellow, #FFD84D);
      right:0;
      top:0;
    }

    @media(max-width:720px){
      .site-header .brand{
        gap:7px;
      }

      .site-header .brand-author{
        padding:5px 8px;
        font-size:.61rem;
      }

      .error-page{
        padding:72px 22px 90px;
      }

      .error-page::before{
        width:230px;
        height:230px;
        border-width:30px;
        right:-120px;
        top:90px;
      }

      .thread-mark{
        display:none;
      }

      .error-actions{
        flex-direction:column;
        align-items:stretch;
      }

      .error-actions a{
        width:100%;
      }
    }
  </style>
</head>

<body>
<header class="site-header">
  <a class="brand" href="index.html" aria-label="The Loom Room by Neri">
    <span class="brand-name">The Loom Room</span>
    <span class="brand-author">by Neri</span>
  </a>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href="expertise.html">Expertise</a>
    <a href="experience.html">Experience</a>
    <a href="insights.html">Insights</a>
    <a href="contact.html">Contact</a>
  </nav>
</header>

<main class="error-page">
  <div class="error-inner">
    <p class="error-kicker">404 / Loose Thread</p>
    <p class="error-code">Page not found</p>

    <h1 class="error-title">
      This page slipped out of the <span class="blue">weave.</span>
    </h1>

    <p class="error-copy">
      The link may be outdated, moved, or still being woven. Head back to The Loom Room,
      browse the latest Insights, or explore the work behind the strategy.
    </p>

    <div class="error-actions">
      <a class="primary" href="index.html">Back to The Loom Room →</a>
      <a class="secondary" href="insights.html">Browse Insights</a>
      <a class="secondary" href="expertise.html">View Expertise</a>
    </div>

    <div class="thread-mark" aria-hidden="true"></div>
  </div>
</main>

<footer class="site-footer">
  <p>© <span id="year"></span> The Loom Room by Neri.</p>
  <p>Marketing strategy, creative execution, and applied problem solving.</p>
</footer>

<script src="main.js"></script>
</body>
</html>
